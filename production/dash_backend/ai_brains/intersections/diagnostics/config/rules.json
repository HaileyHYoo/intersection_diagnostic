{
  "version": "v1.1",
  "note": "Intersections Diagnostics V1 rules. Values follow the agreed methodology (29 Oct 2026); items marked 'decision' were agreed in addition to it.",
  "region": "AU-VIC-Melbourne",
  "timezone": "Australia/Melbourne",
  "period_minutes": 30,
  "quarter_minutes": 15,
  "data_latency_minutes": 5,
  "history": {
    "weeks": 8,
    "min_observations": 5,
    "extend_beyond_weeks": false,
    "exclude": {"public_holidays": true, "dst_change_days": true, "year_end": true}
  },
  "percentiles": {"low": 0.10, "high": 0.90},
  "reference_value": "median",
  "q2": {
    "window_minutes": 60,
    "min_vehicles": 10,
    "require_all_intervals": true,
    "active_detectors_only": true
  },
  "q1": {
    "min_pct_difference": 10,
    "approach_history_min_presence": 1,
    "grey_if_any_approach_missing": true
  },
  "q3a": {"min_pct_difference": 10},
  "q3b": {"higher_is_more_stable": true},
  "q3c": {
    "approach_history_min_presence": 1,
    "grey_site_if_any_approach_without_green": true
  },
  "q3": {"abnormal_required": 2, "assessable_required": 2},
  "alignment": {
    "tolerance_seconds": 60,
    "off_grid": "drop",
    "duplicates": "last"
  },
  "fallbacks": {"enabled": false},
  "tomtom": {
    "api_enabled": true,
    "adequate_quarters": 2,
    "queue_min_minutes": 15,
    "note": "Methodology section 13: Q5 reports approach queue length and the largest queue from the TomTom Junction Analytics queue history (API archive). Needs TOMTOM_API_KEY; without it, or if the call fails, the queue is reported as unavailable and the rest of Q5 still runs."
  },
  "contract": {
    "template_ids": {
      "D001": {"template_id": "ID_Q4_SCATS_INTERPRETATION", "version": "1.0.0"},
      "D002": {"template_id": "ID_Q5_TOMTOM_CONFIRMATION", "version": "1.0.0"}
    },
    "note": "Template registry IDs in the production contract. D001 is the contract's example; the D002 ID is a placeholder until the production team confirms it."
  },
  "click": {
    "red": ["D001", "D002"],
    "amber_traffic": [],
    "amber_signal": [],
    "normal": [],
    "grey": [],
    "detector_health": []
  }
}
