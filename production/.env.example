# Same values as the intersection chatbot's .env
INFLUXDB_URL=https://influxdb.unimelb-transport-technologies.cloud.edu.au/
INFLUXDB_TOKEN=
INFLUXDB_ORG=unimelb-transport
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional: LLM wording of D001/D002 (without it, reports are written by code)
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional
DIAGNOSTICS_DB=diagnostics.sqlite3
# DIAGNOSTICS_SCHEMA_FILE=path/to/production_schema.json
# DIAGNOSTICS_RULES_FILE=path/to/rules.json
# TomTom Junction Analytics queue archive (Q5 queue length; same key as the chatbot's TomTom layer)
TOMTOM_API_KEY=
# Queue archive, as the chatbot's TomTom layer: periods older than 24 h use the historical archive.
# The values depend on the TomTom account; the chatbot's tests use {"archiveType":"HISTORICAL"} / {"archiveType":"LIVE"}.
TOMTOM_QUEUE_HISTORIC_PARAMS=
TOMTOM_QUEUE_RECENT_PARAMS=
TOMTOM_QUEUE_ARCHIVE_URL_TEMPLATE=
TOMTOM_QUEUE_RECENT_URL_TEMPLATE=
